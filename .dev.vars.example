# Copy to .dev.vars and fill in. Loaded by wrangler in local dev only.
# For production, set with: npm run cf -- secret put MY_SECRET
# Bindings (D1, KV, R2, etc.) go in your Wrangler config, NOT here.

# Better Auth uses Google sign-in. Keep all credentials server-side.
BETTER_AUTH_URL="http://localhost:3000"
TRACKER_ORIGIN="http://localhost:3000"
BETTER_AUTH_SECRET="generate-a-random-secret-of-at-least-32-characters"
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# Bearer token for the read-only /ext/v1/* API used by external clients.
# Leave unset to keep /ext/v1/* switched off; it
# fails closed with 503 rather than serving unauthenticated requests.
# Generate one with: openssl rand -hex 32
# ANALYTICS_API_TOKEN="..."
